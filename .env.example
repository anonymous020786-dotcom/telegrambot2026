# ---- Required -----------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=
# Your Telegram user ID (send /id to the bot, or ask @userinfobot). Comma-separate several owners.
ADMIN_IDS=

# ---- Access -------------------------------------------------------------------
# Extra users allowed without an invite (comma-separated IDs)
ALLOWED_USER_IDS=
# true = anyone can use the bot (not recommended)
PUBLIC_MODE=false
# Strangers get a "Request access" button that pings the admins
ACCESS_REQUESTS=true

# ---- Limits -------------------------------------------------------------------
MAX_CONCURRENT_JOBS=3
PER_USER_CONCURRENT_JOBS=2
# Security: links to localhost/private networks are refused. Set true only to download from your own LAN.
ALLOW_PRIVATE_URLS=false
# Automatic retries after rate limits, server errors or network drops (first after 15 s, then 60 s)
TRANSIENT_RETRIES=2
RETRY_DELAY_SECONDS=15
# Downloads per user per day (0 = unlimited; admins are always unlimited)
DAILY_LIMIT=200
MAX_DOWNLOAD_MB=4000
MAX_PLAYLIST_ITEMS=50
MAX_IMAGES_PER_REQUEST=200
FILE_RETENTION_HOURS=6
# 0 = automatic (50 MB with api.telegram.org, 2000 MB with a local Bot API server)
UPLOAD_LIMIT_MB=0

# ---- Big files: self-hosted Bot API server (2 GB uploads) ------------------------
# Get these at https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Uncomment when running `docker compose --profile local-api up -d`
# BOT_API_BASE_URL=http://telegram-bot-api:8081/bot
# BOT_API_BASE_FILE_URL=http://telegram-bot-api:8081/file/bot
# BOT_API_LOCAL_MODE=true

# ---- Big files: expiring download links from this server --------------------------
LINK_SERVER_ENABLED=false
# Public URL where port 8080 is reachable (put HTTPS in front, e.g. Caddy or a load balancer)
LINK_BASE_URL=
LINK_PORT=8080
LINK_TTL_HOURS=6
# Random string; leave empty to generate one per start (old links then stop working after a restart)
LINK_SECRET=

# ---- Big files: Amazon S3 (presigned links) ------------------------------------
S3_BUCKET=
S3_REGION=
S3_PREFIX=downloads/
S3_URL_TTL_HOURS=24

# ---- Networking ----------------------------------------------------------------
# e.g. socks5://user:pass@host:1080 (used for downloads)
PROXY=
# Optional Netscape cookies.txt from your own browser session (for content your account can see)
COOKIES_FILE=

# ---- Content policy ------------------------------------------------------------
# off   = media rated 18+ by the website is refused for everyone
# optin = adults can enable it for themselves with /setadult (admins can change this live with /adult)
ADULT_CONTENT=off
# Never download from these domains (comma-separated; admins can also use /blocksite)
BLOCKED_DOMAINS=

LOG_LEVEL=INFO
WATCH_INTERVAL_MINUTES=30
